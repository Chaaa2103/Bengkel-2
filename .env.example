# ---------- Local development defaults (copy to .env) ----------
NODE_ENV=development
PORT=3000
TZ_OFFSET=+08:00

# Database (local docker-compose MySQL). On AWS the user/password come from Secrets Manager (DB_SECRET_ARN).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartsports
DB_USER=smart
DB_PASSWORD=smartpass
# DB_SSL_CA=/opt/smartsports/rds-global-bundle.pem   (set on AWS so the DB connection is encrypted and verified)

# Secrets (on AWS these come from Secrets Manager via the ARNs below)
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# DB_SECRET_ARN=
# APP_SECRET_ARN=
# IOT_SECRET_ARN=
COOKIE_SECURE=false

# Registration rule BR01. Empty = allow any email domain (local testing).
ALLOWED_EMAIL_DOMAIN=

# First-run seeding. IMPORTANT: a password that contains # MUST be inside quotes, or everything after the # is lost.
AUTO_INIT_DB=true
ADMIN_EMAIL=admin@utem.edu.my
ADMIN_PASSWORD="Admin#12345"
SEED_DEMO=true

# IoT: simulate = built-in fake ESP32 devices, aws = real AWS IoT Core over MQTT/TLS 8883
IOT_MODE=simulate
IOT_ENDPOINT=
# Lights switch ON this many minutes before the slot starts (Progress I UI uses 5). Use 0 for "exactly at start".
LIGHT_LEAD_MIN=5
OFFLINE_AFTER_MIN=2
SCHEDULER_INTERVAL_SEC=15
# SIM_FAIL_RATE=0.3   # simulate lost ACKs to demonstrate the retry logic (0 to 1)

# Telegram bot token from @BotFather (message @BotFather, send /newbot). Empty = Telegram features are switched off.
TELEGRAM_BOT_TOKEN=
# true = students must link Telegram before they can book
REQUIRE_TELEGRAM=false

# Storage: empty S3_BUCKET = files are stored in ./data/uploads
S3_BUCKET=

# Business rules (BR10, BR11, BR12)
MAX_ADVANCE_DAYS=7
MAX_BOOKINGS_PER_DAY=2
CANCEL_CUTOFF_HOURS=2

# SDG energy estimate assumptions (edit to match your court)
LIGHT_KW=1.0
GRID_EF_KG_PER_KWH=0.585
TARIFF_RM_PER_KWH=0.50

# Rate limits (raise temporarily when running the load test from a single IP)
RATE_LIMIT_PER_MIN=300
